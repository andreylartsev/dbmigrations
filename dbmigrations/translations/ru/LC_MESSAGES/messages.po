#: dbmigration.py:201
msgid "Applies base, versioned, and repeatable scripts to the target database schema."
msgstr ""
"Применяет бэйзлайн-скрипты, версионированные и повторяемые скрипты к целевой схеме "
"базы данных."

#: dbmigration.py:203 dbmigration.py:213 dbmigration.py:228 dbmigration.py:235
#: dbmigration.py:242
msgid "the name of target database schema"
msgstr "имя целевой схемы базы данных"

#: dbmigration.py:204 dbmigration.py:214 dbmigration.py:229 dbmigration.py:236
#: dbmigration.py:243
msgid "source scripts repository path"
msgstr "путь к репозиторию с исходными скриптами"

#: dbmigration.py:205
msgid ""
"clean up the latest version within the database and reapply the included *.sql "
"scripts."
msgstr ""
"очистить последнюю версию в базе данных и повторно применить входящие в нее *.sql "
"скрипты."

#: dbmigration.py:206
msgid "reapply all repeatable scripts, regardless of changes."
msgstr ""
"повторно применить все повторяемые (repeatable) скрипты независимо от наличия "
"изменений."

#: dbmigration.py:207
msgid "run the cleanup script before executing version-specific scripts."
msgstr "запустить скрипт очистки перед выполнением скриптов конкретной версии."

#: dbmigration.py:208
msgid "skip confirmation before executing updates."
msgstr "пропускать подтверждение перед выполнением обновлений."

#: dbmigration.py:211
msgid ""
"Validates the target schema and lists versioned and reproducible scripts to apply if "
"the 'update' command is executed."
msgstr ""
"Проверяет целевую схему и выводит список версионированных и повторяемых (repeatable) "
"скриптов для применения в случае выполнения команды 'update'."

#: dbmigration.py:215
msgid "skip grouping changes by git commits"
msgstr "пропустить группировку изменений по коммитам git"

#: dbmigration.py:219
msgid ""
"skip unified text diffs between scripts applied in the database (by git OID) and the "
"current script files in the repository"
msgstr ""
"пропустить текстовые различия между скриптами, применёнными в БД (по git OID), и "
"текущими файлами скриптов в репозитории"

#: dbmigration.py:222
msgid "skip display recent changes stored within target db schema"
msgstr "пропустить отображение недавних изменений, сохраненных в целевой схеме БД"

#: dbmigration.py:223
msgid "the update script path if you want one as an additional result of the verify command"
msgstr ""
"путь к скрипту обновления, если он требуется в качестве дополнительного результата "
"выполнения команды verify"

#: dbmigration.py:226
msgid "Creates version control tables in an empty database schema."
msgstr "Создает таблицы контроля версий в пустой схеме базы данных."

#: dbmigration.py:230
msgid "Force create version control tables even on non empty schema"
msgstr "Принудительно создать таблицы контроля версий даже в непустой схеме"

#: dbmigration.py:233
msgid "Runs db unit test scripts to the target database schema."
msgstr "Запускает скрипты юнит-тестов БД для целевой схемы базы данных."

#: dbmigration.py:237
msgid ""
